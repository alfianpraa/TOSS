# Copy this file to `.env` on the server and fill in real values.
# Never commit the real `.env` — it's already in .gitignore.

# --- Postgres (used by docker-compose to create the db container) ---
POSTGRES_USER=toss_app
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ticketing_system

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-generate-a-new-random-value
AUTH_TRUST_HOST=true

# --- App ---
# Host port the app is published on. Leave at 80 to browse by http://SERVER_IP
APP_PORT=80
